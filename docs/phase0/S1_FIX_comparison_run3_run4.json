      "run3": "PROGRAM PLC_PRG\nVAR\n    (* Deterministic demo for AHU-01 *)\n    StartCommand : BOOL := FALSE;\n    StopCommand : BOOL := FALSE;\n    FanCommand : BOOL := FALSE;\n    FanRunning : BOOL := FALSE;\n    FanFault : BOOL := FALSE;\n    SupplyTemp : REAL := 21.0;\n    Setpoint : REAL := 22.0;\n    FanSpeed : REAL := 50.0;\n    HeatingValve : REAL := 0.0;\n    (* Modbus TCP image (16-bit words, mapped to Modbus_TCP_Server I/O) *)\n    Mb_Command : WORD; (* HR0 Command: bit0=StartCommand, bit1=StopCommand *)\n    Mb_Status : WORD; (* IR0 Status: bit0=FanCommand, bit1=FanRunning, bit2=FanFault *)\nEND_VAR",
      "run4": "PROGRAM PLC_PRG\nVAR\n    (* Deterministic demo for AHU-01 *)\n    StartCommand : BOOL := FALSE;\n    StopCommand : BOOL := FALSE;\n    FanCommand : BOOL := FALSE;\n    FanRunning : BOOL := FALSE;\n    FanFault : BOOL := FALSE;\n    SupplyTemp : REAL := 21.0;\n    Setpoint : REAL := 22.0;\n    FanSpeed : REAL := 50.0;\n    HeatingValve : REAL := 0.0;\n    (* Modbus TCP image (16-bit words, mapped to Modbus_TCP_Server I/O) *)\n    Mb_Command : WORD; (* HR0 Command: bit0=StartCommand, bit1=StopCommand *)\n    Mb_Status : WORD; (* IR0 Status: bit0=FanCommand, bit1=FanRunning, bit2=FanFault *)\nEND_VAR"
    },
    {
      "item": "verify_result.plc_prg_impl",
      "kind": "semantic",
      "equal": true,
      "run3": "(* MODBUS IN: HR0 Command word -> commands *)\nStartCommand := Mb_Command.0;\nStopCommand := Mb_Command.1;\n\n(* FAN START *)\nIF StartCommand = TRUE AND FanFault = FALSE THEN\n    FanCommand := TRUE;\n    FanRunning := TRUE;\nEND_IF;\n\n(* FAN STOP *)\nIF StopCommand = TRUE THEN\n    FanCommand := FALSE;\n    FanRunning := FALSE;\nEND_IF;\n\n(* FAN FAULT *)\nIF FanFault = TRUE THEN\n    FanCommand := FALSE;\n    FanRunning := FALSE;\nEND_IF;\n\n(* HEATING - simple demo, not PID *)\nIF SupplyTemp < Setpoint THEN\n    HeatingValve := 100.0;\nELSE\n    HeatingValve := 0.0;\nEND_IF;\n\n(* MODBUS OUT: status -> IR0 Status word *)\nMb_Status := 0;\nMb_Status.0 := FanCommand;\nMb_Status.1 := FanRunning;\nMb_Status.2 := FanFault;",
      "run4": "(* MODBUS IN: HR0 Command word -> commands *)\nStartCommand := Mb_Command.0;\nStopCommand := Mb_Command.1;\n\n(* FAN START *)\nIF StartCommand = TRUE AND FanFault = FALSE THEN\n    FanCommand := TRUE;\n    FanRunning := TRUE;\nEND_IF;\n\n(* FAN STOP *)\nIF StopCommand = TRUE THEN\n    FanCommand := FALSE;\n    FanRunning := FALSE;\nEND_IF;\n\n(* FAN FAULT *)\nIF FanFault = TRUE THEN\n    FanCommand := FALSE;\n    FanRunning := FALSE;\nEND_IF;\n\n(* HEATING - simple demo, not PID *)\nIF SupplyTemp < Setpoint THEN\n    HeatingValve := 100.0;\nELSE\n    HeatingValve := 0.0;\nEND_IF;\n\n(* MODBUS OUT: status -> IR0 Status word *)\nMb_Status := 0;\nMb_Status.0 := FanCommand;\nMb_Status.1 := FanRunning;\nMb_Status.2 := FanFault;"
    },
