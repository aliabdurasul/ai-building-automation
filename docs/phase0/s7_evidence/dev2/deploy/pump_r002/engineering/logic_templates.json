{
  "schema": "ai_bms.logic_template_bundle.v1",
  "templates": {
    "PUMP_BASIC_V1": {
      "sha256": "a971cb3a6766a309899d1aa48e30a78262b0a89ba0c089d6cd9988931b5bda98",
      "template": {
        "behavior_test": {
          "description": "Commands through Modbus (client-writable mapped slots); fault injected PLC-side (online write); every expectation checked both through Modbus and PLC online read-back.",
          "steps": [
            {
              "expect": {
                "PumpFault": false,
                "PumpRunning": false,
                "PumpState": 0
              },
              "modbus_write": {
                "StartCommand": false,
                "StopCommand": false
              },
              "name": "initial_stopped",
              "plc_write": {
                "PumpFault": false
              }
            },
            {
              "expect": {
                "PumpRunning": true,
                "PumpState": 2
              },
              "modbus_write": {
                "StartCommand": true
              },
              "name": "start"
            },
            {
              "expect": {
                "PumpRunning": true,
                "PumpState": 2
              },
              "modbus_write": {
                "StartCommand": false
              },
              "name": "start_released_keeps_running"
            },
            {
              "expect": {
                "PumpRunning": false,
                "PumpState": 0
              },
              "modbus_write": {
                "StopCommand": true
              },
              "name": "stop"
            },
            {
              "expect": {
                "PumpRunning": false,
                "PumpState": 0
              },
              "modbus_write": {
                "StartCommand": true
              },
              "name": "start_while_stop_held_is_ignored"
            },
            {
              "expect": {
                "PumpRunning": true,
                "PumpState": 2
              },
              "modbus_write": {
                "StopCommand": false
              },
              "name": "stop_released_starts"
            },
            {
              "expect": {
                "PumpFault": true,
                "PumpRunning": false,
                "PumpState": 9
              },
              "name": "fault_while_running_start_held",
              "plc_write": {
                "PumpFault": true
              }
            },
            {
              "expect": {
                "PumpRunning": false,
                "PumpState": 9
              },
              "modbus_write": {
                "StartCommand": false
              },
              "name": "start_released_in_fault"
            },
            {
              "expect": {
                "PumpFault": false,
                "PumpRunning": false,
                "PumpState": 0
              },
              "name": "fault_cleared_stopped",
              "plc_write": {
                "PumpFault": false
              }
            }
          ]
        },
        "body": [
          "(* {{equipment}} : PUMP_BASIC_V1 state machine - 0 STOPPED, 1 STARTING, 2 RUNNING, 3 STOPPING, 9 FAULT *)",
          "IF {{PumpFault}} = TRUE THEN",
          "    {{PumpState}} := 9;",
          "END_IF;",
          "CASE {{PumpState}} OF",
          "0: (* STOPPED *)",
          "    {{PumpRunning}} := FALSE;",
          "    IF {{StartCommand}} = TRUE AND {{StopCommand}} = FALSE THEN",
          "        {{PumpState}} := 1;",
          "    END_IF;",
          "1: (* STARTING: simulated run feedback *)",
          "    {{PumpRunning}} := TRUE;",
          "    IF {{PumpRunning}} = TRUE THEN",
          "        {{PumpState}} := 2;",
          "    END_IF;",
          "2: (* RUNNING *)",
          "    IF {{StopCommand}} = TRUE THEN",
          "        {{PumpState}} := 3;",
          "    END_IF;",
          "3: (* STOPPING *)",
          "    {{PumpRunning}} := FALSE;",
          "    IF {{PumpRunning}} = FALSE THEN",
          "        {{PumpState}} := 0;",
          "    END_IF;",
          "9: (* FAULT *)",
          "    {{PumpRunning}} := FALSE;",
          "    IF {{PumpFault}} = FALSE THEN",
          "        {{PumpState}} := 0;",
          "    END_IF;",
          "ELSE",
          "    {{PumpState}} := 0;",
          "END_CASE;",
          ""
        ],
        "description": "Deterministic demo pump state machine (engineering/PLC behaviour proof, not field pump control). PumpState: 0 STOPPED, 1 STARTING, 2 RUNNING, 3 STOPPING, 9 FAULT. Stop dominates start; PumpFault forces FAULT; leaving FAULT returns to STOPPED. STARTING/STOPPING each last one PLC cycle (simulated run feedback).",
        "equipment_type": "PUMP",
        "id": "PUMP_BASIC_V1",
        "schema": "ai_bms.logic_template.v1",
        "slots": {
          "PumpFault": "BOOL",
          "PumpRunning": "BOOL",
          "PumpState": "INT",
          "StartCommand": "BOOL",
          "StopCommand": "BOOL"
        }
      }
    }
  }
}
