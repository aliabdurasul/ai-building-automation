{
  "schema": "ai_bms.logic_template_bundle.v1",
  "templates": {
    "AHU_SEQ_V1": {
      "sha256": "f634e678829a216103c3d32b9890b7f14ae0631fc05d619e74a67d5a0650c413",
      "template": {
        "behavior_test": null,
        "body": [
          "(* {{equipment}} : AHU_SEQ_V1 - 0 STOPPED, 1 STARTING, 2 DAMPER OPENING, 3 FAN STARTING, 4 RUNNING, 5 STOPPING, 6 DAMPER CLOSING, 9 FAULT *)",
          "{{NowMs}} := TIME_TO_UDINT(TIME());",
          "{{FanFault}} := {{FanFailure}};",
          "{{DamperFault}} := {{DamperFailure}};",
          "{{AhuAlarm}} := {{FanFailure}} OR {{DamperFailure}};",
          "IF {{AhuAlarm}} AND {{AhuState}} <> 9 THEN",
          "    {{AhuState}} := 9;",
          "    {{StateTrace}} := {{StateTrace}} OR 16#0200;",
          "    {{StateEntryMs}} := {{NowMs}};",
          "END_IF;",
          "CASE {{AhuState}} OF",
          "0: (* STOPPED *)",
          "    {{FanCommand}} := FALSE;",
          "    {{FanRunning}} := FALSE;",
          "    {{DamperCommand}} := FALSE;",
          "    {{DamperOpen}} := FALSE;",
          "    IF {{StartCommand}} AND NOT {{StartPrev}} AND NOT {{StopCommand}} THEN",
          "        {{SequenceStarts}} := {{SequenceStarts}} + 1;",
          "        {{StateTrace}} := 16#0002;",
          "        {{AhuState}} := 1;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "1: (* STARTING *)",
          "    {{AhuState}} := 2;",
          "    {{StateTrace}} := {{StateTrace}} OR 16#0004;",
          "    {{StateEntryMs}} := {{NowMs}};",
          "2: (* DAMPER OPENING *)",
          "    {{DamperCommand}} := TRUE;",
          "    IF {{StopCommand}} AND NOT {{StopPrev}} THEN",
          "        {{SequenceStops}} := {{SequenceStops}} + 1;",
          "        {{AhuState}} := 5;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0020;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    ELSIF {{NowMs}} - {{StateEntryMs}} >= {{DamperOpenTime_ms}} THEN",
          "        {{DamperOpen}} := TRUE;",
          "        {{AhuState}} := 3;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0008;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "3: (* FAN STARTING *)",
          "    {{FanCommand}} := TRUE;",
          "    IF {{StopCommand}} AND NOT {{StopPrev}} THEN",
          "        {{SequenceStops}} := {{SequenceStops}} + 1;",
          "        {{AhuState}} := 5;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0020;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    ELSIF {{NowMs}} - {{StateEntryMs}} >= {{FanStartTime_ms}} THEN",
          "        {{FanRunning}} := TRUE;",
          "        {{AhuState}} := 4;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0010;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "4: (* RUNNING *)",
          "    IF {{StopCommand}} AND NOT {{StopPrev}} THEN",
          "        {{SequenceStops}} := {{SequenceStops}} + 1;",
          "        {{AhuState}} := 5;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0020;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "5: (* STOPPING: fan run-down *)",
          "    {{FanCommand}} := FALSE;",
          "    IF {{NowMs}} - {{StateEntryMs}} >= {{FanStopTime_ms}} THEN",
          "        {{FanRunning}} := FALSE;",
          "        {{AhuState}} := 6;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0040;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "6: (* DAMPER CLOSING *)",
          "    {{DamperCommand}} := FALSE;",
          "    IF {{NowMs}} - {{StateEntryMs}} >= {{DamperCloseTime_ms}} THEN",
          "        {{DamperOpen}} := FALSE;",
          "        {{AhuState}} := 0;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0001;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "9: (* FAULT: safe state *)",
          "    {{FanCommand}} := FALSE;",
          "    {{FanRunning}} := FALSE;",
          "    {{DamperCommand}} := FALSE;",
          "    {{DamperOpen}} := FALSE;",
          "    IF NOT {{AhuAlarm}} THEN",
          "        {{AhuState}} := 0;",
          "        {{StateTrace}} := {{StateTrace}} OR 16#0001;",
          "        {{StateEntryMs}} := {{NowMs}};",
          "    END_IF;",
          "ELSE (* unknown state value: safe fallback *)",
          "    {{FanCommand}} := FALSE;",
          "    {{FanRunning}} := FALSE;",
          "    {{DamperCommand}} := FALSE;",
          "    {{DamperOpen}} := FALSE;",
          "    {{AhuState}} := 0;",
          "    {{StateEntryMs}} := {{NowMs}};",
          "END_CASE;",
          "{{StartPrev}} := {{StartCommand}};",
          "{{StopPrev}} := {{StopCommand}};",
          "",
          "(* HEATING - simple demo, not PID *)",
          "IF {{SupplyTemp}} < {{Setpoint}} THEN",
          "    {{HeatingValve}} := 100.0;",
          "ELSE",
          "    {{HeatingValve}} := 0.0;",
          "END_IF;",
          ""
        ],
        "description": "Deterministic demo AHU start/stop sequence (engineering/PLC behaviour proof, not field control). AhuState: 0 STOPPED, 1 STARTING (one PLC cycle), 2 DAMPER OPENING, 3 FAN STARTING, 4 RUNNING, 5 STOPPING (fan run-down), 6 DAMPER CLOSING, 9 FAULT. START and STOP act on rising edges only: a held command never re-triggers. START is accepted only in STOPPED and only while STOP is not held; STOP is accepted in DAMPER OPENING, FAN STARTING and RUNNING. FanFailure or DamperFailure forces FAULT from any state (fan, damper off); FAULT returns to STOPPED when both are clear (a new START edge is needed). Damper end switch and fan run feedback are simulated after the parameter times. Unknown AhuState values fall back to STOPPED. Heating: HeatingValve 100 when SupplyTemp < Setpoint else 0 (same rule as AHU_S1FIX_V1, not PID). Status contract unchanged: FanCommand, FanRunning, FanFault. StateTrace bit n = state n visited since the last accepted START (bit 9 FAULT); SequenceStarts / SequenceStops count accepted START / STOP edges.",
        "equipment_type": "AHU",
        "id": "AHU_SEQ_V1",
        "parameters": {
          "DamperCloseTime_ms": 2000,
          "DamperOpenTime_ms": 2000,
          "FanStartTime_ms": 1000,
          "FanStopTime_ms": 1000
        },
        "schema": "ai_bms.logic_template.v1",
        "slots": {
          "AhuAlarm": "BOOL",
          "AhuState": "INT",
          "DamperCommand": "BOOL",
          "DamperFailure": "BOOL",
          "DamperFault": "BOOL",
          "DamperOpen": "BOOL",
          "FanCommand": "BOOL",
          "FanFailure": "BOOL",
          "FanFault": "BOOL",
          "FanRunning": "BOOL",
          "HeatingValve": "REAL",
          "NowMs": "UDINT",
          "SequenceStarts": "UINT",
          "SequenceStops": "UINT",
          "Setpoint": "REAL",
          "StartCommand": "BOOL",
          "StartPrev": "BOOL",
          "StateEntryMs": "UDINT",
          "StateTrace": "WORD",
          "StopCommand": "BOOL",
          "StopPrev": "BOOL",
          "SupplyTemp": "REAL"
        }
      }
    }
  }
}
