{
  "schema": "ai_bms.logic_template.v1",
  "id": "AHU_S1FIX_V1",
  "equipment_type": "AHU",
  "description": "S1-FIX AHU demo behaviour: fan start/stop/fault, heating valve 100 when SupplyTemp < Setpoint else 0. Not PID, not field control.",
  "slots": {
    "StartCommand": "BOOL",
    "StopCommand": "BOOL",
    "FanCommand": "BOOL",
    "FanRunning": "BOOL",
    "FanFault": "BOOL",
    "SupplyTemp": "REAL",
    "Setpoint": "REAL",
    "HeatingValve": "REAL"
  },
  "body": [
    "(* FAN START *)",
    "IF {{StartCommand}} = TRUE AND {{FanFault}} = FALSE THEN",
    "    {{FanCommand}} := TRUE;",
    "    {{FanRunning}} := TRUE;",
    "END_IF;",
    "",
    "(* FAN STOP *)",
    "IF {{StopCommand}} = TRUE THEN",
    "    {{FanCommand}} := FALSE;",
    "    {{FanRunning}} := FALSE;",
    "END_IF;",
    "",
    "(* FAN FAULT *)",
    "IF {{FanFault}} = TRUE THEN",
    "    {{FanCommand}} := FALSE;",
    "    {{FanRunning}} := FALSE;",
    "END_IF;",
    "",
    "(* HEATING - simple demo, not PID *)",
    "IF {{SupplyTemp}} < {{Setpoint}} THEN",
    "    {{HeatingValve}} := 100.0;",
    "ELSE",
    "    {{HeatingValve}} := 0.0;",
    "END_IF;",
    ""
  ],
  "behavior_test": null
}
