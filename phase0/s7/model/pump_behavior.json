{
  "schema": "ai_bms.behavior_scenario.v1",
  "name": "PUMP-01 PUMP_BASIC_V1 S7 regression",
  "description": "S7 PUMP behaviour complementing the PUMP_BASIC_V1 template behaviour test: Modbus trace of the start/stop transitions (STARTING / STOPPING last one PLC cycle, so they are allowed but not required on Modbus), the STARTING and STOPPING branches proven by forcing PumpState online, unknown state fallback, fault while stopped, and REAL32 read-back of PumpSpeed / Pressure / FlowRate (PLC online write, Modbus FC4 decoded with the S3-measured word order).",
  "steps": [
    {"name": "reset",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StartCommand": false, "PUMP-DEMO/PUMP-01/StopCommand": false},
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpFault": false},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0, "PUMP-DEMO/PUMP-01/PumpRunning": false, "PUMP-DEMO/PUMP-01/PumpFault": false}},
    {"name": "PUMP_start_trace",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StartCommand": true},
     "trace": {"until": {"PUMP-DEMO/PUMP-01/PumpState": 2}, "timeout_s": 5,
               "signals": {"PUMP-DEMO/PUMP-01/PumpState": {"sequence": [2], "allow": [0, 1]},
                           "PUMP-DEMO/PUMP-01/PumpRunning": {"sequence": [true], "allow": [false]}}},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 2, "PUMP-DEMO/PUMP-01/PumpRunning": true}},
    {"name": "start_released",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StartCommand": false},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 2}},
    {"name": "PUMP_stop_trace",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StopCommand": true},
     "trace": {"until": {"PUMP-DEMO/PUMP-01/PumpState": 0}, "timeout_s": 5,
               "signals": {"PUMP-DEMO/PUMP-01/PumpState": {"sequence": [0], "allow": [2, 3]},
                           "PUMP-DEMO/PUMP-01/PumpRunning": {"sequence": [false], "allow": [true]}}},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0, "PUMP-DEMO/PUMP-01/PumpRunning": false}},
    {"name": "stop_released",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StopCommand": false}, "wait_ms": 500,
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0}},
    {"name": "state1_starting_branch_forced",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpState": 1},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 2, "PUMP-DEMO/PUMP-01/PumpRunning": true}},
    {"name": "state3_stopping_branch_forced",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpState": 3},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0, "PUMP-DEMO/PUMP-01/PumpRunning": false}},
    {"name": "negative_unknown_state_falls_back_to_stopped",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpState": 77}, "wait_ms": 300,
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0, "PUMP-DEMO/PUMP-01/PumpRunning": false}},
    {"name": "PUMP_fault_while_stopped",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpFault": true},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 9, "PUMP-DEMO/PUMP-01/PumpFault": true, "PUMP-DEMO/PUMP-01/PumpRunning": false}},
    {"name": "negative_start_during_fault_blocked",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StartCommand": true}, "wait_ms": 1000,
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 9, "PUMP-DEMO/PUMP-01/PumpRunning": false}},
    {"name": "start_released_in_fault",
     "modbus_write": {"PUMP-DEMO/PUMP-01/StartCommand": false},
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 9}},
    {"name": "PUMP_fault_recovery_stopped",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpFault": false}, "wait_ms": 500,
     "expect": {"PUMP-DEMO/PUMP-01/PumpState": 0, "PUMP-DEMO/PUMP-01/PumpFault": false, "PUMP-DEMO/PUMP-01/PumpRunning": false}},

    {"name": "PUMP_REAL32_50_0",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 50.0, "PUMP-DEMO/PUMP-01/Pressure": 50.0, "PUMP-DEMO/PUMP-01/FlowRate": 50.0},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 50.0, "PUMP-DEMO/PUMP-01/Pressure": 50.0, "PUMP-DEMO/PUMP-01/FlowRate": 50.0}},
    {"name": "PUMP_REAL32_3_75",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 3.75, "PUMP-DEMO/PUMP-01/Pressure": 3.75, "PUMP-DEMO/PUMP-01/FlowRate": 3.75},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 3.75, "PUMP-DEMO/PUMP-01/Pressure": 3.75, "PUMP-DEMO/PUMP-01/FlowRate": 3.75}},
    {"name": "PUMP_REAL32_21_5",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 21.5, "PUMP-DEMO/PUMP-01/Pressure": 21.5, "PUMP-DEMO/PUMP-01/FlowRate": 21.5},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 21.5, "PUMP-DEMO/PUMP-01/Pressure": 21.5, "PUMP-DEMO/PUMP-01/FlowRate": 21.5}},
    {"name": "PUMP_REAL32_123_456",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 123.456, "PUMP-DEMO/PUMP-01/Pressure": 123.456, "PUMP-DEMO/PUMP-01/FlowRate": 123.456},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 123.456, "PUMP-DEMO/PUMP-01/Pressure": 123.456, "PUMP-DEMO/PUMP-01/FlowRate": 123.456}},
    {"name": "PUMP_REAL32_distinct_per_signal",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 50.0, "PUMP-DEMO/PUMP-01/Pressure": 3.75, "PUMP-DEMO/PUMP-01/FlowRate": 21.5},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 50.0, "PUMP-DEMO/PUMP-01/Pressure": 3.75, "PUMP-DEMO/PUMP-01/FlowRate": 21.5}},
    {"name": "cleanup",
     "plc_write": {"PUMP-DEMO/PUMP-01/PumpSpeed": 0.0, "PUMP-DEMO/PUMP-01/Pressure": 0.0, "PUMP-DEMO/PUMP-01/FlowRate": 0.0},
     "expect": {"PUMP-DEMO/PUMP-01/PumpSpeed": 0.0, "PUMP-DEMO/PUMP-01/Pressure": 0.0, "PUMP-DEMO/PUMP-01/FlowRate": 0.0,
                "PUMP-DEMO/PUMP-01/PumpState": 0}}
  ]
}
