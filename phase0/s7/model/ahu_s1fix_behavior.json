{
  "schema": "ai_bms.behavior_scenario.v1",
  "name": "AHU-01 AHU_S1FIX_V1 existing behaviour",
  "description": "S7 behaviour of the existing S1/S1-FIX AHU logic (template AHU_S1FIX_V1) on the running SoftPLC. The logic is level-based (no edge detection, no sequence, no damper): START latches FanCommand/FanRunning while FanFault is FALSE, STOP and FanFault reset them, STOP wins over START in the same scan. Commands through Modbus HR0, FanFault / SupplyTemp by PLC online write; mapped signals checked through Modbus AND PLC read-back.",
  "steps": [
    {"name": "reset_stopped",
     "modbus_write": {"AHU-S1/AHU-01/Command": 2},
     "plc_write": {"plc:FanFault": false},
     "expect": {"AHU-S1/AHU-01/Status": 0, "plc:FanCommand": false, "AHU-S1/AHU-01/FanRunning": false, "plc:FanFault": false}},
    {"name": "reset_command_cleared",
     "modbus_write": {"AHU-S1/AHU-01/Command": 0},
     "expect": {"AHU-S1/AHU-01/Status": 0}},

    {"name": "AHU_START_hr0_1",
     "modbus_write": {"AHU-S1/AHU-01/Command": 1},
     "expect": {"AHU-S1/AHU-01/Status": 3, "plc:FanCommand": true, "AHU-S1/AHU-01/FanRunning": true, "plc:FanFault": false,
                "plc:StartCommand": true, "plc:StopCommand": false}},
    {"name": "start_held",
     "wait_ms": 1500,
     "expect": {"AHU-S1/AHU-01/Status": 3, "AHU-S1/AHU-01/FanRunning": true}},
    {"name": "start_released_stays_running",
     "modbus_write": {"AHU-S1/AHU-01/Command": 0}, "wait_ms": 500,
     "expect": {"AHU-S1/AHU-01/Status": 3, "plc:StartCommand": false, "AHU-S1/AHU-01/FanRunning": true}},
    {"name": "negative_invalid_command_bit2_while_running",
     "modbus_write": {"AHU-S1/AHU-01/Command": 4}, "wait_ms": 1000,
     "expect": {"AHU-S1/AHU-01/Status": 3, "plc:StartCommand": false, "plc:StopCommand": false}},

    {"name": "AHU_STOP_hr0_2",
     "modbus_write": {"AHU-S1/AHU-01/Command": 2},
     "expect": {"AHU-S1/AHU-01/Status": 0, "plc:FanCommand": false, "AHU-S1/AHU-01/FanRunning": false, "plc:StopCommand": true}},
    {"name": "stop_held",
     "wait_ms": 1500,
     "expect": {"AHU-S1/AHU-01/Status": 0}},
    {"name": "stop_released_stays_stopped",
     "modbus_write": {"AHU-S1/AHU-01/Command": 0}, "wait_ms": 500,
     "expect": {"AHU-S1/AHU-01/Status": 0, "plc:StopCommand": false}},
    {"name": "negative_invalid_command_bit3_while_stopped",
     "modbus_write": {"AHU-S1/AHU-01/Command": 8}, "wait_ms": 1000,
     "expect": {"AHU-S1/AHU-01/Status": 0}},
    {"name": "negative_conflicting_start_stop_stop_wins",
     "modbus_write": {"AHU-S1/AHU-01/Command": 3}, "wait_ms": 1000,
     "expect": {"AHU-S1/AHU-01/Status": 0, "plc:StartCommand": true, "plc:StopCommand": true, "plc:FanCommand": false}},
    {"name": "conflict_stop_released_start_level_starts",
     "modbus_write": {"AHU-S1/AHU-01/Command": 1},
     "expect": {"AHU-S1/AHU-01/Status": 3}},

    {"name": "AHU_FAULT_fan_fault_while_running",
     "plc_write": {"plc:FanFault": true},
     "expect": {"AHU-S1/AHU-01/Status": 4, "plc:FanCommand": false, "AHU-S1/AHU-01/FanRunning": false, "plc:FanFault": true}},
    {"name": "negative_start_held_during_fault_blocked",
     "wait_ms": 1000,
     "expect": {"AHU-S1/AHU-01/Status": 4, "plc:FanCommand": false}},
    {"name": "AHU_FAULT_RECOVERY_fault_cleared_level_start_restarts",
     "plc_write": {"plc:FanFault": false},
     "expect": {"AHU-S1/AHU-01/Status": 3, "plc:FanFault": false, "AHU-S1/AHU-01/FanRunning": true}},
    {"name": "fault_recovery_stop",
     "modbus_write": {"AHU-S1/AHU-01/Command": 2},
     "expect": {"AHU-S1/AHU-01/Status": 0}},
    {"name": "fault_while_stopped",
     "modbus_write": {"AHU-S1/AHU-01/Command": 0},
     "plc_write": {"plc:FanFault": true},
     "expect": {"AHU-S1/AHU-01/Status": 4, "plc:FanCommand": false}},
    {"name": "negative_start_during_fault_blocked",
     "modbus_write": {"AHU-S1/AHU-01/Command": 1}, "wait_ms": 1000,
     "expect": {"AHU-S1/AHU-01/Status": 4, "plc:FanCommand": false, "AHU-S1/AHU-01/FanRunning": false}},
    {"name": "fault_cleared_after_start_released_stays_stopped",
     "modbus_write": {"AHU-S1/AHU-01/Command": 0},
     "plc_write": {"plc:FanFault": false}, "wait_ms": 500,
     "expect": {"AHU-S1/AHU-01/Status": 0, "plc:FanFault": false}},

    {"name": "AHU_HEATING_supply_below_setpoint",
     "modbus_write": {"AHU-S1/AHU-01/Setpoint": 22.0},
     "plc_write": {"AHU-S1/AHU-01/SupplyTemp": 18.0},
     "expect": {"AHU-S1/AHU-01/Setpoint": 22.0, "AHU-S1/AHU-01/SupplyTemp": 18.0, "AHU-S1/AHU-01/HeatingValve": 100.0}},
    {"name": "heating_supply_equal_setpoint",
     "plc_write": {"AHU-S1/AHU-01/SupplyTemp": 22.0},
     "expect": {"AHU-S1/AHU-01/SupplyTemp": 22.0, "AHU-S1/AHU-01/HeatingValve": 0.0}},
    {"name": "heating_supply_above_setpoint",
     "plc_write": {"AHU-S1/AHU-01/SupplyTemp": 25.5},
     "expect": {"AHU-S1/AHU-01/SupplyTemp": 25.5, "AHU-S1/AHU-01/HeatingValve": 0.0}},
    {"name": "heating_setpoint_raised_over_modbus",
     "modbus_write": {"AHU-S1/AHU-01/Setpoint": 30.0},
     "expect": {"AHU-S1/AHU-01/Setpoint": 30.0, "AHU-S1/AHU-01/HeatingValve": 100.0}},
    {"name": "cleanup",
     "modbus_write": {"AHU-S1/AHU-01/Setpoint": 22.0, "AHU-S1/AHU-01/Command": 0},
     "plc_write": {"AHU-S1/AHU-01/SupplyTemp": 21.0},
     "expect": {"AHU-S1/AHU-01/Setpoint": 22.0, "AHU-S1/AHU-01/SupplyTemp": 21.0, "AHU-S1/AHU-01/HeatingValve": 100.0,
                "AHU-S1/AHU-01/Status": 0}}
  ]
}
