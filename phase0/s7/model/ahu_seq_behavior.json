{
  "schema": "ai_bms.behavior_scenario.v1",
  "name": "AHU-01 AHU_SEQ_V1 behaviour",
  "description": "S7 AHU behaviour on the running SoftPLC (template AHU_SEQ_V1, timings from the template parameters). Commands through Modbus HR0 (bit0 START, bit1 STOP); faults / test values by PLC online write; every expectation on a mapped signal is checked through Modbus AND PLC online read-back (plc:* keys are PLC-only variables). StateTrace bits: 1 STARTING, 2 DAMPER OPENING, 3 FAN STARTING, 4 RUNNING, 5 STOPPING, 6 DAMPER CLOSING, 0 STOPPED, 9 FAULT.",
  "steps": [
    {"name": "reset",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "plc_write": {"plc:FanFailure": false, "plc:DamperFailure": false, "AHU-SEQ/AHU-01/SequenceStarts": 0, "AHU-SEQ/AHU-01/SequenceStops": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/SequenceStarts": 0,
                "AHU-SEQ/AHU-01/SequenceStops": 0, "AHU-SEQ/AHU-01/AhuAlarm": false, "AHU-SEQ/AHU-01/DamperOpen": false}},

    {"name": "AHU_START_start_edge",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 4}, "timeout_s": 8,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [2, 3, 4], "allow": [0, 1],
                                                       "durations_ms": {"2": "AHU-01.DamperOpenTime_ms", "3": "AHU-01.FanStartTime_ms"}},
                           "AHU-SEQ/AHU-01/Status": {"sequence": [1, 3], "allow": [0]},
                           "AHU-SEQ/AHU-01/DamperCommand": {"sequence": [true], "allow": [false]},
                           "AHU-SEQ/AHU-01/DamperOpen": {"sequence": [true], "allow": [false]},
                           "AHU-SEQ/AHU-01/FanRunning": {"sequence": [true], "allow": [false]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/Status": 3, "plc:FanCommand": true,
                "AHU-SEQ/AHU-01/FanRunning": true, "plc:FanFault": false, "AHU-SEQ/AHU-01/DamperCommand": true,
                "AHU-SEQ/AHU-01/DamperOpen": true, "AHU-SEQ/AHU-01/SequenceStarts": 1, "AHU-SEQ/AHU-01/StateTrace": 30}},
    {"name": "start_held",
     "wait_ms": 1500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/Status": 3, "AHU-SEQ/AHU-01/SequenceStarts": 1,
                "AHU-SEQ/AHU-01/StateTrace": 30}},
    {"name": "start_released",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/Status": 3, "AHU-SEQ/AHU-01/SequenceStarts": 1}},
    {"name": "start_edge_while_running_ignored",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/SequenceStarts": 1, "AHU-SEQ/AHU-01/StateTrace": 30}},

    {"name": "AHU_STOP_stop_edge",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 2},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 0}, "timeout_s": 8,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [5, 6, 0], "allow": [4],
                                                       "durations_ms": {"5": "AHU-01.FanStopTime_ms", "6": "AHU-01.DamperCloseTime_ms"}},
                           "AHU-SEQ/AHU-01/Status": {"sequence": [2, 0], "allow": [3]},
                           "AHU-SEQ/AHU-01/FanRunning": {"sequence": [false], "allow": [true]},
                           "AHU-SEQ/AHU-01/DamperOpen": {"sequence": [false], "allow": [true]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "plc:FanCommand": false,
                "AHU-SEQ/AHU-01/FanRunning": false, "plc:FanFault": false, "AHU-SEQ/AHU-01/DamperCommand": false,
                "AHU-SEQ/AHU-01/DamperOpen": false, "AHU-SEQ/AHU-01/SequenceStops": 1, "AHU-SEQ/AHU-01/StateTrace": 127}},
    {"name": "stop_held",
     "wait_ms": 1500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/SequenceStops": 1, "AHU-SEQ/AHU-01/SequenceStarts": 1}},
    {"name": "stop_released",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/SequenceStops": 1}},
    {"name": "stop_edge_while_stopped_ignored",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 2}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/SequenceStops": 1, "AHU-SEQ/AHU-01/Status": 0}},

    {"name": "negative_invalid_command_bit2",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 4}, "wait_ms": 1000,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/SequenceStarts": 1,
                "AHU-SEQ/AHU-01/SequenceStops": 1}},
    {"name": "negative_invalid_command_bit3",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 8}, "wait_ms": 1000,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/SequenceStarts": 1}},
    {"name": "command_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},
    {"name": "negative_conflicting_start_stop_from_stopped",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 3}, "wait_ms": 1000,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/SequenceStarts": 1}},
    {"name": "conflict_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},

    {"name": "start_for_running_fault",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 4}, "timeout_s": 8,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [2, 3, 4], "allow": [0, 1]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/Status": 3, "AHU-SEQ/AHU-01/SequenceStarts": 2}},
    {"name": "AHU_FAULT_fan_failure_during_running",
     "plc_write": {"plc:FanFailure": true},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 9, "AHU-SEQ/AHU-01/Status": 4, "plc:FanFault": true,
                "AHU-SEQ/AHU-01/AhuAlarm": true, "AHU-SEQ/AHU-01/DamperFault": false, "plc:FanCommand": false,
                "AHU-SEQ/AHU-01/FanRunning": false, "AHU-SEQ/AHU-01/DamperCommand": false,
                "AHU-SEQ/AHU-01/DamperOpen": false, "AHU-SEQ/AHU-01/StateTrace": 542}},
    {"name": "start_released_in_fault",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0}, "wait_ms": 300,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 9, "AHU-SEQ/AHU-01/Status": 4}},
    {"name": "negative_start_edge_in_fault_ignored",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 9, "AHU-SEQ/AHU-01/Status": 4, "AHU-SEQ/AHU-01/SequenceStarts": 2}},
    {"name": "AHU_FAULT_RECOVERY_fan_failure_cleared_start_held_stays_stopped",
     "plc_write": {"plc:FanFailure": false}, "wait_ms": 1000,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "plc:FanFault": false,
                "AHU-SEQ/AHU-01/AhuAlarm": false, "AHU-SEQ/AHU-01/SequenceStarts": 2, "AHU-SEQ/AHU-01/StateTrace": 543}},
    {"name": "fault_recovery_command_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},

    {"name": "start_for_starting_fault",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 2}, "timeout_s": 3,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [2], "allow": [0, 1]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 2, "AHU-SEQ/AHU-01/DamperCommand": true, "AHU-SEQ/AHU-01/DamperOpen": false,
                "AHU-SEQ/AHU-01/SequenceStarts": 3}},
    {"name": "negative_damper_failure_during_starting",
     "plc_write": {"plc:DamperFailure": true},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 9, "AHU-SEQ/AHU-01/DamperFault": true, "AHU-SEQ/AHU-01/AhuAlarm": true,
                "plc:FanFault": false, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/DamperCommand": false,
                "AHU-SEQ/AHU-01/FanRunning": false, "AHU-SEQ/AHU-01/StateTrace": 518}},
    {"name": "damper_failure_cleared",
     "plc_write": {"plc:DamperFailure": false}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/DamperFault": false, "AHU-SEQ/AHU-01/AhuAlarm": false,
                "AHU-SEQ/AHU-01/SequenceStarts": 3}},
    {"name": "damper_fault_command_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},

    {"name": "start_for_abort",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 3}, "timeout_s": 5,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [2, 3], "allow": [0, 1]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 3, "AHU-SEQ/AHU-01/Status": 1, "AHU-SEQ/AHU-01/SequenceStarts": 4}},
    {"name": "stop_edge_during_fan_starting_aborts",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 2},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 0}, "timeout_s": 8,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [5, 6, 0], "allow": [3],
                                                       "durations_ms": {"5": "AHU-01.FanStopTime_ms", "6": "AHU-01.DamperCloseTime_ms"}}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "AHU-SEQ/AHU-01/SequenceStops": 2,
                "AHU-SEQ/AHU-01/DamperOpen": false, "AHU-SEQ/AHU-01/StateTrace": 111}},
    {"name": "abort_command_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},

    {"name": "start_for_unknown_state",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 1},
     "trace": {"until": {"AHU-SEQ/AHU-01/AhuState": 4}, "timeout_s": 8,
               "signals": {"AHU-SEQ/AHU-01/AhuState": {"sequence": [2, 3, 4], "allow": [0, 1]}}},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 4, "AHU-SEQ/AHU-01/SequenceStarts": 5}},
    {"name": "negative_unknown_state_falls_back_to_stopped",
     "plc_write": {"AHU-SEQ/AHU-01/AhuState": 77}, "wait_ms": 500,
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0, "plc:FanCommand": false,
                "AHU-SEQ/AHU-01/FanRunning": false, "AHU-SEQ/AHU-01/DamperCommand": false,
                "AHU-SEQ/AHU-01/DamperOpen": false, "AHU-SEQ/AHU-01/SequenceStarts": 5}},
    {"name": "unknown_state_command_cleared",
     "modbus_write": {"AHU-SEQ/AHU-01/Command": 0},
     "expect": {"AHU-SEQ/AHU-01/AhuState": 0}},

    {"name": "AHU_HEATING_supply_below_setpoint",
     "modbus_write": {"AHU-SEQ/AHU-01/Setpoint": 22.0},
     "plc_write": {"AHU-SEQ/AHU-01/SupplyTemp": 18.0},
     "expect": {"AHU-SEQ/AHU-01/Setpoint": 22.0, "AHU-SEQ/AHU-01/SupplyTemp": 18.0, "AHU-SEQ/AHU-01/HeatingValve": 100.0}},
    {"name": "heating_supply_equal_setpoint",
     "plc_write": {"AHU-SEQ/AHU-01/SupplyTemp": 22.0},
     "expect": {"AHU-SEQ/AHU-01/SupplyTemp": 22.0, "AHU-SEQ/AHU-01/HeatingValve": 0.0}},
    {"name": "heating_supply_above_setpoint",
     "plc_write": {"AHU-SEQ/AHU-01/SupplyTemp": 25.5},
     "expect": {"AHU-SEQ/AHU-01/SupplyTemp": 25.5, "AHU-SEQ/AHU-01/HeatingValve": 0.0}},
    {"name": "heating_setpoint_raised_over_modbus",
     "modbus_write": {"AHU-SEQ/AHU-01/Setpoint": 30.0},
     "expect": {"AHU-SEQ/AHU-01/Setpoint": 30.0, "AHU-SEQ/AHU-01/HeatingValve": 100.0}},
    {"name": "cleanup",
     "modbus_write": {"AHU-SEQ/AHU-01/Setpoint": 22.0, "AHU-SEQ/AHU-01/Command": 0},
     "plc_write": {"AHU-SEQ/AHU-01/SupplyTemp": 21.0},
     "expect": {"AHU-SEQ/AHU-01/Setpoint": 22.0, "AHU-SEQ/AHU-01/SupplyTemp": 21.0, "AHU-SEQ/AHU-01/HeatingValve": 100.0,
                "AHU-SEQ/AHU-01/AhuState": 0, "AHU-SEQ/AHU-01/Status": 0}}
  ]
}
